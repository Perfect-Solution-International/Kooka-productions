#!/bin/bash
#
# Reject staged files large enough for GitHub to decline the push.
#
# GitHub's pre-receive hook rejects any blob over 100MB. Because the whole
# branch is uploaded before that check runs, a single oversized file fails the
# push after the transfer completes, and deleting the file afterwards does not
# help -- the blob is still in history and has to be purged with a rewrite.
# Failing here costs a second instead.
#
# Bypass a false positive with: git commit --no-verify

limit=$((95 * 1024 * 1024))
oversized=()

# Process substitution keeps the loop in this shell; piping into `while` would
# run it in a subshell and discard everything appended to `oversized`.
while IFS= read -r -d '' file; do
  [ -f "$file" ] || continue

  size=$(wc -c < "$file")
  if ((size > limit)); then
    oversized+=("$(printf '%s (%d MB)' "$file" $((size / 1048576)))")
  fi
done < <(git diff --cached --name-only --diff-filter=AM -z)

if ((${#oversized[@]} > 0)); then
  echo "commit blocked -- file(s) over 95MB, GitHub's limit is 100MB:" >&2
  printf '  %s\n' "${oversized[@]}" >&2
  echo >&2
  echo "Unstage them (git restore --staged <file>) and commit a compressed" >&2
  echo "derivative instead -- for video, a .webm/.mp4 transcode." >&2
  exit 1
fi
