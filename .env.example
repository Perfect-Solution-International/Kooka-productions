# Copy to .env and fill in. Never commit .env.

# MySQL connection used by Prisma (prisma.config.ts reads it via dotenv).
DATABASE_URL="mysql://root:1234@localhost:3306/kooka"

# HMAC key for the admin session cookie. Independent of any user password.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Seed-only: the first admin account created by `npm run db:seed`.
# ADMIN_NAME is optional and falls back to the local part of ADMIN_EMAIL.
ADMIN_NAME="Kooka Admin"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
